{
  "repo": {
    "allow_rebase_merge": false,
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "squash_merge_commit_title": "PR_TITLE",
    "squash_merge_commit_message": "COMMIT_MESSAGES",
    "delete_branch_on_merge": true,
    "secret_scanning": "enabled",
    "secret_scanning_push_protection": "enabled"
  },
  "dependabot_alerts": true,
  "private_vulnerability_reporting": true,
  "workflow_permissions": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "fork_pr_approval": {
    "approval_policy": "all_external_contributors"
  },
  "ruleset": {
    "name": "main-protection",
    "target": "branch",
    "enforcement": "active",
    "bypass_actors": [],
    "include": ["~DEFAULT_BRANCH"],
    "exclude": [],
    "rule_types": ["deletion", "non_fast_forward", "pull_request", "required_linear_history", "required_status_checks"],
    "pull_request": {
      "required_approving_review_count": 0,
      "required_review_thread_resolution": true,
      "dismiss_stale_reviews_on_push": false,
      "require_code_owner_review": false,
      "require_last_push_approval": false,
      "allowed_merge_methods": ["squash"]
    },
    "required_status_checks": {
      "strict_required_status_checks_policy": true,
      "required_status_checks": [
        {"context": "analyze (actions)", "integration_id": 15368},
        {"context": "analyze (java-kotlin)", "integration_id": 15368},
        {"context": "checks", "integration_id": 15368},
        {"context": "pr-rules", "integration_id": 15368},
        {"context": "release-smoke", "integration_id": 15368},
        {"context": "ui-tests (phone-31)", "integration_id": 15368}
      ]
    }
  },
  "label": {
    "name": "dependencies"
  },
  "environments": {
    "release-please": {
      "deployment_branch_policy": {"custom_branch_policies": true, "protected_branches": false},
      "branch_policies": ["main"],
      "reviewers": [],
      "prevent_self_review": false,
      "can_admins_bypass": true,
      "secrets": ["RELEASE_APP_PRIVATE_KEY"]
    },
    "release": {
      "deployment_branch_policy": {"custom_branch_policies": true, "protected_branches": false},
      "branch_policies": ["main"],
      "reviewers": [{"type": "User", "id": 286747515}],
      "prevent_self_review": false,
      "can_admins_bypass": false,
      "secrets": ["RELEASE_KEYSTORE_BASE64", "RELEASE_KEYSTORE_PASSWORD", "RELEASE_KEY_ALIAS", "RELEASE_KEY_PASSWORD"]
    }
  },
  "variables": ["RELEASE_APP_CLIENT_ID", "RELEASE_CERT_SHA256"],
  "release_tags": {
    "name": "release-tags",
    "target": "tag",
    "enforcement": "active",
    "include": ["refs/tags/v*"],
    "rule_types": ["creation", "deletion", "non_fast_forward", "update"],
    "bypass_actors": [{"actor_id": 5641111, "actor_type": "Integration", "bypass_mode": "always"}]
  },
  "release_labels": ["autorelease: pending", "autorelease: tagged"],
  "immutable_releases": {"enabled": true}
}
